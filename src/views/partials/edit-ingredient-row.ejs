<%# One editable ingredient. The index keeps each row's fields together when the form is sent
    (ingredients[0][name], ingredients[0][unit]...). The "Add ingredient" button reuses this with a placeholder index. %>
<% const label = ingredient.name || 'new ingredient'; %>
<%# Example hints (1/2, cup) only go in blank rows. In a filled-in row, an empty box showing a grey
    "1/2" looks like part of the recipe %>
<% const isBlank = !ingredient.name; %>
<li class="ingredient-row">
  <input type="text" name="ingredients[<%= index %>][quantity]" value="<%= ingredient.quantity %>" <% if (isBlank) { %>placeholder="1/2" <% } %>maxlength="20" aria-label="Quantity for <%= label %>">
  <input type="text" name="ingredients[<%= index %>][unit]" value="<%= ingredient.unit %>" <% if (isBlank) { %>placeholder="cup" <% } %>maxlength="40" aria-label="Unit for <%= label %>">
  <input type="text" name="ingredients[<%= index %>][name]" value="<%= ingredient.name %>" <% if (isBlank) { %>placeholder="Ingredient" <% } %>maxlength="80" aria-label="Ingredient name">
  <label class="remove">
    <input type="checkbox" name="ingredients[<%= index %>][remove]" value="1"> Remove
  </label>
</li>
