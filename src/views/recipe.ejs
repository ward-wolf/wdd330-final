<%- include('partials/head') %>
<%- include('partials/header') %>
<main class="recipe">
  <h1><%= recipe.name %></h1>
  <p class="meta"><%= recipe.area %> &middot; <%= recipe.category %></p>

  <%# "Add to my day" saves this recipe to the day plan in the browser (public/js/add-to-day.js).
      It's hidden until that script runs, since it can't work without it %>
  <div class="day-actions" id="day-actions" data-recipe-id="<%= recipe.id %>" hidden>
    <button type="button" class="button" id="add-to-day">Add to my day</button>
    <p class="day-message" id="day-message" role="status"></p>
    <a href="/my-day">View my day</a>
  </div>

  <div class="recipe-top">
    <img src="<%= recipe.thumbnail %>" alt="<%= recipe.name %>" width="400" height="400">

    <%- include('partials/nutrition-totals') %>
  </div>

  <section>
    <div class="section-heading">
      <h2>Ingredients</h2>
      <%# data-servings-link lets servings.js keep the servings number in this link %>
      <a class="button" href="/recipe/<%= recipe.id %>/edit?servings=<%= servings %>" data-servings-link>Edit ingredients</a>
    </div>
    <%- include('partials/ingredient-nutrition') %>
  </section>

  <section>
    <h2>Instructions</h2>
    <%# Instructions come as one block of text, so split it into a paragraph per line and skip blank lines %>
    <% recipe.instructions.split(/\r?\n/).filter(line => line.trim()).forEach(line => { %>
      <p><%= line %></p>
    <% }) %>
    <% if (recipe.source) { %>
      <p><a href="<%= recipe.source %>">Original recipe</a></p>
    <% } %>
  </section>
</main>
<script src="/js/servings.js"></script>
<script type="module" src="/js/add-to-day.js"></script>
<%- include('partials/footer') %>
