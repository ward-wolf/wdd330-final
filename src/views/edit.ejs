<%- include('partials/head') %>
<%- include('partials/header') %>
<main class="edit">
  <p><a href="/recipe/<%= recipe.id %>?servings=<%= servings %>" data-servings-link>&larr; Back to <%= recipe.name %></a></p>
  <h1>Edit ingredients</h1>
  <p class="meta"><%= recipe.name %></p>
  <p>Change any amount or ingredient, add new ones, then select <strong>Update nutrition</strong>.
     Units can be words like cup, tbsp, tsp, g or oz, or vague ones like pinch or handful.
     Your changes aren't saved once you leave this page.</p>

  <%- include('partials/ingredient-form', {
    formAction: `/recipe/${recipe.id}/edit`,
    submitLabel: 'Update nutrition',
    blankRows: 1,
    resetHref: `/recipe/${recipe.id}/edit?servings=${servings}`,
    resetLabel: 'Reset to original',
  }) %>

  <%- include('partials/nutrition-results', { heading: 'Nutrition for your version' }) %>
</main>
<script src="/js/servings.js"></script>
<script src="/js/edit-ingredients.js"></script>
<%- include('partials/footer') %>
